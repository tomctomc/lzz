// navg_DclSpecFlags.lzz
//
// declarator specifier flags
//

$hdr
$end

$src
$end

// gram
namespace gram
{
  // dcl specifier flags
  enum
  {
    // inline
    INLINE_SPEC    = 1 << 0,

    // virtual
    VIRTUAL_SPEC   = 1 << 1,

    // explicit
    EXPLICIT_SPEC  = 1 << 2,

    // static
    STATIC_SPEC    = 1 << 3,

    // extern
    EXTERN_SPEC    = 1 << 4,

    // mutable
    MUTABLE_SPEC   = 1 << 5,

    // auto
    AUTO_SPEC      = 1 << 6,

    // register
    REGISTER_SPEC  = 1 << 7,

    // function pure specifier
    PURE_SPEC      = 1 << 8,

    // dll api
    DLL_API_SPEC   = 1 << 9,

    // override virt specifier (C++11)
    OVERRIDE_SPEC  = 1 << 10,

    // final virt specifier (C++11)
    FINAL_SPEC     = 1 << 11,

    // defaulted function (C++11, = default)
    DEFAULTED_SPEC = 1 << 12,

    // deleted function (C++11, = delete)
    DELETED_SPEC   = 1 << 13,

    // trailing return type (C++11, auto f () -> T); the return type itself
    // is carried in the decl, this flag only selects the emission form
    TRAILING_RET_SPEC = 1 << 14,

    // constexpr (C++11); definitions must live in the header
    CONSTEXPR_SPEC = 1 << 15,
  }
}
