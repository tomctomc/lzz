// conditional noexcept: the constant expression is block-lexed and re-emitted
// verbatim in BOTH the declaration and the out-of-line definition; before this
// worked the backtracking parser found a function-returning-function parse for
// noexcept(expr) and emitted garbage like 'int (f () noexcept) (true);'
class NX
{
public:
  int f () noexcept (true)
  {
    return 1;
  }
  int g () const noexcept (false)
  {
    return 2;
  }
  ~ NX () noexcept (false)
  {
  }
  int nested (NX & o) noexcept (noexcept (1 + 1))
  {
    return 0;
  }
  virtual int v () noexcept (true)
  {
    return 3;
  }
};
class NXD : public NX
{
public:
  int v () noexcept (true) override
  {
    return 4;
  }
};
void free_func () noexcept (false)
{
}
template <class T>
T tmpl_func (T t) noexcept (sizeof (T) < 8)
{
  return t;
}
