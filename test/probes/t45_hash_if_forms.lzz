// passed through: template class members, nested class, extern "C" block, elif chain
template <class T>
class Tmpl
{
public:
#ifdef ARCH_X
    T x () { return T (); }
#endif
    T y () { return T (); }
};
class Outer
{
public:
    class Inner
    {
#ifdef ARCH_X
        int a;
#endif
        int b;
    };
#ifdef ARCH_X
    Inner in;
#endif
};
extern "C"
{
#ifdef ARCH_X
    int cfn (int);
#endif
}
#if defined (ARCH_X)
int chain () { return 1; }
#elif defined (ARCH_Y)
int chain () { return 2; }
#else
int chain () { return 3; }
#endif
