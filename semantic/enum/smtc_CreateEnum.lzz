// semantic
namespace smtc
{
  // create enum
  EnumPtr createEnum (util::Loc const & loc, NamePtr const & name, bool is_scoped, CvType const & base_type,
      EnumtorPtrVector const & enumtor_set)
  {
    return new Enum (loc, name, is_scoped, base_type, enumtor_set);
  }
}
