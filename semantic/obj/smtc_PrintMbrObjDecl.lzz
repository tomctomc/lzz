// smtc_PrintMbrObjDecl.lzz
//

$hdr
// semantic
#include "smtc_FilePtr.h"
#include "smtc_ObjPtr.h"
$end

$src
// semantic
#include "smtc_PrintObjDecl.h"
#end

// semantic
namespace smtc
{
  // print mbr obj decl
  void printMbrObjDecl (FilePtr const & file, ObjPtr const & obj)
  {
    PrintObjDecl printer;
    // the initializer of a static member prints with its definition in the
    // source file, not with the declaration; the value then stays out of
    // the header whether or not the member is const integral
    printer.print (file, DECLARATION_SECTION, obj);
  }
}
