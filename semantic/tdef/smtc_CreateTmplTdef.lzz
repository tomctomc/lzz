// semantic
namespace smtc
{
  // create tmpl tdef (alias template)
  TmplTdefPtr createTmplTdef (TmplSpecPtrVector const & tmpl_spec_set, TdefPtr const & tdef)
  {
    return new TmplTdef (tmpl_spec_set, tdef);
  }
}
