// smtc_ClassDefn.lzz
//

$hdr
// semantic
#include "smtc_BaseSpecPtrVector.h"
#include "smtc_ClassDecl.h"
#include "smtc_EntityPtrDeque.h"

// util
#include "util_IdentSet.h"
#include "util_Loc.h"

// std lib
#include <vector>
$end

$src
$end

// semantic
namespace smtc
{
  // ClassDefn
  class ClassDefn : public ClassDecl
  {
    // base spec set
    BaseSpecPtrVector m_base_spec_set;

    // entity set
    EntityPtrDeque m_entity_set;

    // types in scope (used for qualifing function return types)
    util::IdentSet m_type_name_set;

    // true if class definition is dependent (ie: a template class definition), if true
    // return types are pefixed with 'typename' in definition
    bool m_dpdt;

    // true if class is declared final (C++11), printed in the defn head only
    bool m_is_final;

    // qualified class name relative to enclosing ns
    NamePtr m_qual_name;

    // passed-through conditional directive groups open in the class body (locations of their #if
    // lines), every group opened in the body must be closed in it (see smtc_DeclareHashDir)
    std::vector <util::Loc> m_open_hash_if_set;

  public:
    // constructor
    ClassDefn (ClassKey key, NamePtr const & name, bool is_dll_api, BaseSpecPtrVector const & base_spec_set)
      : ClassDecl (key, name, is_dll_api), m_base_spec_set (base_spec_set), m_dpdt (false), m_is_final (false)
    {
    }

    // destructor
    ~ ClassDefn ()
    {
    }

    // get base spec set
    inline BaseSpecPtrVector const & getBaseSpecSet () const
    {
      return m_base_spec_set;
    }

    // get entity set
    inline EntityPtrDeque const & getEntitySet () const
    {
      return m_entity_set;
    }

    // add entity
    void addEntity (EntityPtr const & entity)
    {
      m_entity_set.push_back (entity);
    }


    // add type name
    void addTypeName (util::Ident const & type_name)
    {
      m_type_name_set.insert (type_name);
    }

    // get type name set
    util::IdentSet const & getTypeNameSet () const
    {
      return m_type_name_set;
    }

    // set final
    void setFinal ()
    {
      m_is_final = true;
    }

    // true if final
    bool isFinal () const
    {
      return m_is_final;
    }

    // set dependent
    void setDependent ()
    {
      m_dpdt = true;
    }

    // true if dependent
    bool isDependent () const
    {
      return m_dpdt;
    }

    // set qualified name
    void setQualName (NamePtr const & qual_name)
    {
      m_qual_name = qual_name;
    }

    // get qual name
    NamePtr const & getQualName () const
    {
      return m_qual_name;
    }

    // open a conditional group at loc
    void openHashIf (util::Loc const & loc)
    {
      m_open_hash_if_set.push_back (loc);
    }

    // close the innermost open conditional group, false if none
    bool closeHashIf ()
    {
      if (m_open_hash_if_set.empty ())
      {
        return false;
      }
      m_open_hash_if_set.pop_back ();
      return true;
    }

    // true if a conditional group is open
    bool hasOpenHashIf () const
    {
      return ! m_open_hash_if_set.empty ();
    }

    // true if a conditional group is open, set loc to that of the innermost one
    bool hasOpenHashIf (util::Loc & loc) const
    {
      if (m_open_hash_if_set.empty ())
      {
        return false;
      }
      loc = m_open_hash_if_set.back ();
      return true;
    }
  }
}
