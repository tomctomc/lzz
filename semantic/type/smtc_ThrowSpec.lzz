// smtc_ThrowSpec.lzz
//

$hdr
// semantic
#include "smtc_CvTypeVector.h"

// util
#include "util_String.h"
$end

$src
$end

// semantic
namespace smtc
{
  // ThrowSpec
  class ThrowSpec
  {
    // true if noexcept (C++11) rather than a throw () spec
    bool m_noexcept;

    // noexcept constant expression, verbatim (empty if simple form)
    util::String m_noexcept_expr;

    // type set
    CvTypeVector m_cv_type_set;

  public:
    // constructor
    ThrowSpec (CvTypeVector const & cv_type_set)
      : m_noexcept (false), m_cv_type_set (cv_type_set)
    {
    }

    // noexcept constructor, expr empty if simple form
    ThrowSpec (util::String const & noexcept_expr)
      : m_noexcept (true), m_noexcept_expr (noexcept_expr)
    {
    }

    // true if noexcept
    inline bool isNoexcept () const
    {
      return m_noexcept;
    }

    // get noexcept expr (empty if simple form)
    inline util::String const & getNoexceptExpr () const
    {
      return m_noexcept_expr;
    }

    // destructor
    ~ ThrowSpec ()
    {
    }

    // get cv type set
    CvTypeVector const & getCvTypeSet () const
    {
      return m_cv_type_set;
    }
  }
}
