// smtc_CreateThrowSpec.lzz
//

$hdr
// semantic
#include "smtc_CvTypeVector.h"
#include "smtc_ThrowSpecPtr.h"

// util
#include "util_String.h"
$end

$src
// semantic
#include "smtc_ThrowSpec.h"
$end

// semantic
namespace smtc
{
  // create throw spec
  ThrowSpecPtr createThrowSpec (CvTypeVector const & cv_type_set)
  {
    return new ThrowSpec (cv_type_set);
  }

  // create noexcept spec (C++11), expr empty if simple form
  ThrowSpecPtr createNoexceptSpec (util::String const & noexcept_expr = util::String ())
  {
    return new ThrowSpec (noexcept_expr);
  }
}
