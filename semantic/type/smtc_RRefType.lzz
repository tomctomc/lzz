// smtc_RRefType.lzz
//
// rvalue reference type (C++11)
//

$hdr
// semantic
#include "smtc_CvType.h"
#include "smtc_Type.h"
$end

$src
// util
#include "util_AppendWithSpace.h"
$end

// semantic
namespace smtc
{
  // RRefType
  class RRefType : public Type
  {
    // to type
    CvType m_to_cv_type;

  public:
    // constructor
    RRefType (CvType const & to_cv_type)
      : m_to_cv_type (to_cv_type)
    {
    }

    // destructor
    ~ RRefType ()
    {
    }

    // get kind
    TypeKind getKind () const
    {
      return RREF_TYPE;
    }

    // to string
    util::String toString (util::String const & dcl, bool c, bool v) const
    {
      util::String str;
      str = "&&";
      util::appendWithSpace (str, dcl);
      return m_to_cv_type.toString (str);
    }

    // get to cv type
    inline CvType const & getToCvType () const
    {
      return m_to_cv_type;
    }
  }
}
