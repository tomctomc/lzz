// smtc_MbrInit.lzz
//

$hdr
// semantic
#include "smtc_NamePtr.h"

// util
#include "util_String.h"
$end

$src
$end

// semantic
namespace smtc
{
  // MbrInit
  class MbrInit
  {
    // name
    NamePtr m_name;

    // arg set
    util::String m_arg_set;

    // true if arg set is a C++11 brace initializer (printed without parens)
    bool m_is_brace;

  public:
    // constructor
    MbrInit (NamePtr const & name, util::String const & arg_set, bool is_brace)
      : m_name (name), m_arg_set (arg_set), m_is_brace (is_brace)
    {
    }

    // destructor
    ~ MbrInit ()
    {
    }

    // get name
    inline NamePtr const & getName () const
    {
      return m_name;
    }

    // get arg set
    inline util::String const & getArgSet () const
    {
      return m_arg_set;
    }

    // true if brace initializer
    inline bool isBrace () const
    {
      return m_is_brace;
    }
  }
}
